# Coffee Chat Copilot reads .env from this folder, the repo root, or the folder ABOVE the repo.
# Use ONE of these (spelled exactly like this). Never commit your real .env.
PORTKEY_API_KEY=
OPENAI_API_KEY=

# Optional
# OPENAI_MODEL=gpt-6-luna          # only used with OPENAI_API_KEY; the course key always uses gpt-6-luna
# DAILY_TOKEN_BUDGET=400000        # hard stop for the day
# RUN_TOKEN_BUDGET=60000           # hard stop for one email
# MAX_LLM_CALLS_PER_RUN=10         # loop guard
# MAX_RUNS_PER_MINUTE=8            # rate limit
# REASONING_EFFORT=low
# USE_PROMPT_CACHE=1
# COPILOT_MOCK=1                   # force demo mode (no API calls)
